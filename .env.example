# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/earnings_analyzer
# DATABASE_URL=sqlite:///./earnings_analyzer.db  # For local development

# App Settings
APP_NAME=Earnings Calls Analyzer
APP_VERSION=0.1.0
DEBUG=False

# AWS Credentials (Required for Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Bedrock Model Configuration
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# Vector Store Configuration
VECTOR_DIMENSION=1024
FAISS_INDEX_DIR=./data/indices

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# SQLAlchemy
SQLALCHEMY_ECHO=False
